{
  "name": "autoshift-console",
  "version": "0.0.1",
  "description": "Read-only OpenShift console plugin for AutoShift fleet configuration",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auto-shift/autoshift-console-plugin.git"
  },
  "scripts": {
    "sync-targets": "node scripts/sync-targets.mjs",
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production ./scripts/ocp.sh webpack --config ../../webpack.config.ts",
    "build-dev": "yarn clean && ./scripts/ocp.sh webpack --config ../../webpack.config.ts",
    "start": "./scripts/ocp.sh webpack serve --config ../../webpack.config.ts",
    "start-console": "./start-console.sh",
    "i18n": "i18next-cli lint && i18next-cli extract",
    "test": "LANG=en_US.UTF-8 ./scripts/ocp.sh jest --config ../../jest.config.ts",
    "lint": "eslint src integration-tests --fix --max-warnings 0 && stylelint 'src/**/*.css' --allow-empty-input --fix",
    "test-e2e": "playwright test --headed",
    "test-e2e-headless": "playwright test"
  },
  "devDependencies": {
    "@playwright/browser-chromium": "~1.62.1",
    "@playwright/test": "~1.62.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/webpack-env": "^1.18.8",
    "comment-json": "^4.2.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.11.0",
    "i18next": "^26.4.0",
    "i18next-cli": "1.69.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "js-yaml": "^5.3.0",
    "prettier": "^3.9.6",
    "react-compiler-runtime": "^1.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependenciesMeta": {
    "@playwright/browser-chromium": {
      "built": true
    }
  },
  "consolePlugin": {
    "name": "autoshift-console",
    "version": "0.0.1",
    "displayName": "AutoShift",
    "description": "Fleet configuration, resolution provenance and policy compliance for clusters managed by AutoShift.",
    "exposedModules": {
      "FleetPage": "./components/FleetPage",
      "ClusterSetsPage": "./components/ClusterSetsPage",
      "ClustersPage": "./components/ClustersPage",
      "StacksPage": "./components/StacksPage"
    }
  },
  "packageManager": "yarn@4.17.1"
}
